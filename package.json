{
  "name": "kuvia",
  "version": "0.4.1",
  "description": "Simple web image gallery generator",
  "main": "bin/kuvia.js",
  "bin": {
    "kuvia": "bin/kuvia.js"
  },
  "scripts": {
    "lint:check": "eslint web/*.js bin/*.js",
    "lint:fix": "eslint --fix web/*.js bin/*.js",
    "format:check": "prettier -c .",
    "format:fix": "prettier -w .",
    "types:check": "tsc --project jsconfig.json && tsc --project web/jsconfig.json",
    "fix:all": "npm run format:fix && npm run lint:fix",
    "all:check": "npm run format:check && npm run lint:check && npm run types:check && npm run test",
    "test": "jest --coverage"
  },
  "dependencies": {
    "csso": "^5.0.5",
    "glob": "^11.0.1",
    "terser": "^5.39.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/csso": "^5.0.4",
    "@types/jest": "^29.5.14",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jpallari/kuvia.git"
  },
  "author": "Jaakko Pallari",
  "license": "BSD-2-Clause",
  "jest": {
    "coverageReporters": [
      "text",
      "cobertura"
    ]
  }
}
